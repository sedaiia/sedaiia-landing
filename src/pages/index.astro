---
import { createClient } from '@sanity/client';

const client = createClient({
  projectId: 'drbqows2',
  dataset: 'production',
  useCdn: true,
  apiVersion: '2024-01-01',
});

interface Belief {
  textEn: string;
  textNl: string;
  highlightEn?: string;
  highlightNl?: string;
}
interface TimelineRow {
  year: string;
  descEn: string;
  descNl: string;
}
interface SkillGroup {
  label: string;
  items: string;
}
interface LandingPage {
  heroHeadlineEn?: string;
  heroHeadlineNl?: string;
  heroSubEn?: string;
  heroSubNl?: string;
  heroImage?: { asset: { url: string } };
  manifestBodyEn?: string;
  manifestBodyNl?: string;
  manifestImage?: { asset: { url: string } };
  beliefs?: Belief[];
  aboutBodyEn?: string;
  aboutBodyNl?: string;
  timeline?: TimelineRow[];
  skills?: SkillGroup[];
  contactEmail?: string;
}

const data = await client.fetch<LandingPage>(`
  *[_type == "landingPage" && _id == "landingPage"][0]{
    heroHeadlineEn, heroHeadlineNl,
    heroSubEn, heroSubNl,
    heroImage { asset -> { url } },
    manifestBodyEn, manifestBodyNl,
    manifestImage { asset -> { url } },
    beliefs[] { textEn, textNl, highlightEn, highlightNl },
    aboutBodyEn, aboutBodyNl,
    timeline[] { year, descEn, descNl },
    skills[] { label, items },
    contactEmail
  }
`).catch(() => null);

const lp = data ?? {};

// Fallbacks
const heroHeadlineEn = lp.heroHeadlineEn ?? 'The hand behind\nthe machine.';
const heroHeadlineNl = lp.heroHeadlineNl ?? 'De hand achter\nde machine.';
const heroSubEn = lp.heroSubEn ?? "Twenty years of traditional craft as the foundation for AI that doesn't feel generic.";
const heroSubNl = lp.heroSubNl ?? 'Twintig jaar traditioneel vakmanschap als fundament voor AI die niet generiek aanvoelt.';

const manifestBodyEn = lp.manifestBodyEn ?? `Most AI output is generic because there's nothing underneath it. No reference, no hand, no twenty years of learning why something works.\n\nI work the other way around. Craft first — branding, typography, illustration, print. Since 2003. That's the reference. AI is the tool that scales that reference, not one that replaces it.\n\nAn old illustration used as exact input for an AI output looks different from a prompt built from nothing. More precise. More personal. Less accidental. That difference is the entire point.`;
const manifestBodyNl = lp.manifestBodyNl ?? `De meeste AI-output is generiek omdat er niets onder ligt. Geen referentie, geen hand, geen twintig jaar waarin je leerde waarom iets werkt.\n\nIk werk andersom. Eerst het vakmanschap — branding, typografie, illustratie, print. Sinds 2003. Dat is de referentie. AI is het gereedschap dat die referentie schaalt, niet vervangt.\n\nEen oude illustratie die als exacte input dient voor een AI-output ziet er anders uit dan een prompt vanuit het niets. Preciezer. Persoonlijker. Minder toevallig. Dat verschil is het hele punt.`;

const beliefs: Belief[] = lp.beliefs ?? [
  { textEn: 'Craft first, AI second.', textNl: 'Vakmanschap eerst, AI daarna.', highlightEn: 'Craft first,', highlightNl: 'Vakmanschap eerst,' },
  { textEn: 'The process is just as much the work.', textNl: 'Het proces is net zo goed het werk.', highlightEn: 'the work.', highlightNl: 'het werk.' },
  { textEn: 'Not the fastest — the sharpest.', textNl: 'Niet het snelste, wel het scherpste.', highlightEn: 'the sharpest.', highlightNl: 'wel het scherpste.' },
];

const aboutBodyEn = lp.aboutBodyEn ?? `Creative director and founder of Studio Sedaiia, based in Almere, the Netherlands.\n\nTwenty years in the field: corporate identity, branding, print and DTP, illustration, web. Twelve years running my own tattoo practice in surrealism and conceptual work. Self-taught in development and AI tooling — I build what I design.\n\nThe through-line is systems thinking: I'll build the process underneath just as readily as the work on top.`;
const aboutBodyNl = lp.aboutBodyNl ?? `Creative director en oprichter van Studio Sedaiia, gevestigd in Almere.\n\nTwintig jaar in het vak: corporate identity, branding, print en DTP, illustratie, web. Twaalf jaar een eigen tattoopraktijk in surrealisme en conceptueel werk. Autodidact in development en AI-tooling — ik bouw zelf wat ik bedenk.\n\nDe rode draad is systeemdenken: ik bouw net zo makkelijk het proces eronder als het werk erbovenop.`;

const timeline: TimelineRow[] = lp.timeline ?? [
  { year: '2003', descEn: 'started in graphic design', descNl: 'start in grafische vormgeving' },
  { year: '~12 yr', descEn: 'own tattoo practice — surrealism / conceptual', descNl: 'eigen tattoopraktijk — surrealisme / conceptueel' },
  { year: 'now', descEn: 'Studio Sedaiia — AI-first creative work', descNl: 'Studio Sedaiia — AI-first creatief werk' },
];

const skills: SkillGroup[] = lp.skills ?? [
  { label: 'DESIGN', items: 'Photoshop, Illustrator, InDesign, Cinema4D basics, Figma, Framer' },
  { label: 'AI', items: 'Higgsfield, image / motion pipelines, AI content engine' },
  { label: 'BUILD', items: 'Squarespace, Next.js, Supabase, Vercel, VS Code' },
];

const contactEmail = lp.contactEmail ?? 'hello@sedaiia.com';
const manifestImageUrl = lp.manifestImage?.asset?.url;
const heroImageUrl = lp.heroImage?.asset?.url;

// Helper: inject highlight span
function withHighlight(text: string, highlight?: string): string {
  if (!highlight) return text;
  return text.replace(highlight, `<span class="hi">${highlight}</span>`);
}

// Helper: text with \n\n => <p> tags
function toParagraphs(text: string): string {
  return text.split(/\n\n+/).map(p => `<p>${p.trim()}</p>`).join('');
}

// Helper: headline with \n => <br>
function toHeadlineHtml(text: string): string {
  return text.split('\n').join('<br/>');
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Studio Sedaiia — the hand behind the machine</title>
  <meta name="description" content="Traditional craft is exactly what keeps AI work from being generic. Creative director and founder of Studio Sedaiia." />
  <meta name="robots" content="index, follow" />
  <link rel="alternate" hreflang="en" href="https://sedaiia.com/" />
  <link rel="alternate" hreflang="nl" href="https://sedaiia.com/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content="Studio Sedaiia — the hand behind the machine" />
  <meta property="og:description" content="Traditional craft is exactly what keeps AI work from being generic." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://sedaiia.com/" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* Lenis smooth scroll */
    html.lenis, html.lenis body { height: auto; }
    .lenis:not(.lenis-autoToggle).lenis-stopped { overflow: clip; }
    .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
    .lenis.lenis-smooth iframe { pointer-events: none; }

    :root {
      --lime: #CAFF00;
      --dot: 1px;
      --gap: 5px;
      --repeat: calc(var(--dot) + var(--gap));
      --dot-line: repeating-linear-gradient(90deg, #000 0, #000 var(--dot), transparent var(--dot), transparent var(--repeat));
      --dot-col:  repeating-linear-gradient(180deg, #000 0, #000 var(--dot), transparent var(--dot), transparent var(--repeat));
    }

    html { scroll-behavior: smooth; }

    body {
      background: #fff;
      color: #000;
      font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif;
      line-height: 1.6;
    }

    /* ── Language visibility ── */
    [data-lang] { display: none; }
    body.lang-en [data-lang="en"],
    body.lang-nl [data-lang="nl"] { display: block; }
    body.lang-en span[data-lang="en"],
    body.lang-nl span[data-lang="nl"] { display: inline; }

    /* ── Header ── */
    header {
      position: fixed;
      top: 0; left: 0;
      width: 100vw;
      z-index: 50;
      padding: 28px 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(255,255,255,0.95);
    }

    header::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0; height: 1px;
      background-image: var(--dot-line);
      background-size: var(--repeat) 1px;
    }

    .logo-link {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #000;
      font-size: 11px;
      letter-spacing: 0.25em;
      transition: opacity 0.2s;
    }
    .logo-link:hover { opacity: 0.45; }
    .lp { fill: #000; }

    .lang-toggle {
      display: flex;
      align-items: center;
      gap: 2px;
    }

    .lang-btn {
      background: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      font-size: 11px;
      letter-spacing: 0.2em;
      padding: 4px 8px;
      color: #000;
      opacity: 0.3;
      transition: opacity 0.2s;
    }
    .lang-btn.active { opacity: 1; }
    .lang-btn:hover { opacity: 0.6; }
    .lang-sep { font-size: 11px; color: rgba(0,0,0,0.2); }

    /* ── Main ── */
    main {
      padding-top: 88px;
      opacity: 0;
      transition: opacity 0.8s ease;
    }
    main.visible { opacity: 1; }

    /* ── Shared ── */
    .section-wrap {
      max-width: 1280px;
      margin: 0 auto;
      padding: 120px 48px;
      background-image: var(--dot-line);
      background-size: var(--repeat) 1px;
      background-position: 0 100%;
      background-repeat: repeat-x;
    }

    .section-label {
      display: block;
      font-size: 10px;
      letter-spacing: 0.35em;
      color: rgba(0,0,0,0.3);
      margin-bottom: 48px;
    }

    /* ── 1. Hero ── */
    .hero {
      position: relative;
      overflow: hidden;
      max-width: 1280px;
      margin: 0 auto;
      padding: 140px 48px 120px;
      background-image: var(--dot-line);
      background-size: var(--repeat) 1px;
      background-position: 0 100%;
      background-repeat: repeat-x;
    }

    .hero-bg {
      position: absolute;
      inset: 0 0 1px 0;
      z-index: 0;
    }
    .hero-bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .hero-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(255,255,255,0.62), rgba(255,255,255,0.86));
    }

    .hero-content { position: relative; z-index: 1; }

    .hero-headline {
      font-size: clamp(40px, 6vw, 80px);
      font-weight: 400;
      line-height: 1.05;
      letter-spacing: -0.02em;
      margin-bottom: 32px;
      max-width: 860px;
    }

    .hero-sub {
      font-size: clamp(16px, 1.8vw, 20px);
      color: rgba(0,0,0,0.45);
      max-width: 520px;
      line-height: 1.65;
      font-family: Helvetica, Arial, sans-serif;
    }

    /* ── 2. Manifest ── */
    .manifest-body {
      max-width: 680px;
      font-size: 18px;
      line-height: 1.85;
      color: rgba(0,0,0,0.7);
      font-family: Helvetica, Arial, sans-serif;
    }
    .manifest-body p + p { margin-top: 24px; }

    .manifest-img {
      margin-top: 72px;
      width: 100%;
      display: block;
      object-fit: cover;
    }

    .image-slot {
      margin-top: 72px;
      width: 100%;
      aspect-ratio: 16/7;
      background: rgba(0,0,0,0.04);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px dashed rgba(0,0,0,0.12);
    }
    .image-slot span {
      font-size: 10px;
      letter-spacing: 0.3em;
      color: rgba(0,0,0,0.2);
    }

    /* ── 3. Beliefs ── */
    .beliefs-list {
      list-style: none;
      max-width: 860px;
    }

    .beliefs-list li {
      font-size: clamp(24px, 3.5vw, 44px);
      font-weight: 400;
      padding: 36px 0;
      letter-spacing: -0.01em;
      line-height: 1.15;
      background-image: var(--dot-line);
      background-size: var(--repeat) 1px;
      background-position: 0 100%;
      background-repeat: repeat-x;
    }

    .beliefs-list li:first-child {
      background-image: var(--dot-line), var(--dot-line);
      background-size: var(--repeat) 1px;
      background-position: 0 0, 0 100%;
      background-repeat: repeat-x;
    }

    .hi { background: #000; color: var(--lime); padding: 2px 8px; }

    /* ── 4. About ── */
    .about-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 80px;
      align-items: start;
    }

    .about-body {
      font-size: 15px;
      line-height: 1.85;
      color: rgba(0,0,0,0.6);
      font-family: Helvetica, Arial, sans-serif;
    }
    .about-body p + p { margin-top: 16px; }

    .timeline {
      margin-top: 40px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .timeline-row {
      display: grid;
      grid-template-columns: 72px 1fr;
      gap: 16px;
      font-size: 13px;
    }
    .t-year {
      font-family: 'Courier New', monospace;
      font-size: 11px;
      letter-spacing: 0.1em;
      color: rgba(0,0,0,0.3);
      padding-top: 2px;
    }
    .t-desc { color: rgba(0,0,0,0.6); font-family: Helvetica, Arial, sans-serif; }

    .skills { display: flex; flex-direction: column; gap: 28px; }
    .skill-group { display: flex; flex-direction: column; gap: 8px; }
    .skill-label {
      font-size: 10px;
      letter-spacing: 0.35em;
      color: rgba(0,0,0,0.3);
    }
    .skill-items {
      font-size: 13px;
      color: rgba(0,0,0,0.65);
      font-family: Helvetica, Arial, sans-serif;
      line-height: 1.6;
    }

    /* ── 5. Work door ── */
    .doors {
      max-width: 1280px;
      margin: 0 auto;
      background-image: var(--dot-line);
      background-size: var(--repeat) 1px;
      background-position: 0 100%;
      background-repeat: repeat-x;
    }

    .door {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 72px 48px;
      text-decoration: none;
      color: #fff;
      background: #000;
      min-height: 300px;
      transition: background 0.2s;
    }

    .door:hover { background-color: #0a0a0a; }

    .door-index {
      font-size: 10px;
      letter-spacing: 0.35em;
      color: rgba(255,255,255,0.35);
      margin-bottom: 24px;
      display: block;
    }

    .door-name {
      font-size: clamp(28px, 3vw, 40px);
      font-weight: 400;
      letter-spacing: -0.01em;
      margin-bottom: 16px;
    }

    .door-desc {
      font-size: 14px;
      color: rgba(255,255,255,0.5);
      font-family: Helvetica, Arial, sans-serif;
      line-height: 1.65;
      max-width: 340px;
    }

    .door-arrow {
      margin-top: 48px;
      width: 40px;
      height: 40px;
      border: 1px solid rgba(255,255,255,0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s, border-color 0.2s;
    }

    .door-arrow path { stroke: #fff; }

    .door:hover .door-arrow { background: #fff; border-color: #fff; }
    .door:hover .door-arrow path { stroke: #000; }

    /* ── 6. Contact ── */
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: start;
    }

    .contact-headline {
      font-size: clamp(26px, 3vw, 40px);
      font-weight: 400;
      letter-spacing: -0.01em;
      line-height: 1.2;
    }

    .contact-sub {
      margin-top: 16px;
      font-size: 13px;
      color: rgba(0,0,0,0.35);
      font-family: Helvetica, Arial, sans-serif;
    }

    .contact-fields { display: flex; flex-direction: column; gap: 24px; }
    .contact-field { display: flex; flex-direction: column; gap: 6px; }
    .contact-key {
      font-size: 10px;
      letter-spacing: 0.35em;
      color: rgba(0,0,0,0.3);
    }
    .contact-val {
      font-size: 15px;
      font-family: Helvetica, Arial, sans-serif;
      color: #000;
      text-decoration: none;
      transition: opacity 0.2s;
    }
    a.contact-val:hover { opacity: 0.45; }

    /* ── Footer ── */
    footer {
      max-width: 1280px;
      margin: 0 auto;
      padding: 32px 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid rgba(0,0,0,0.07);
    }

    footer p, footer a {
      font-size: 11px;
      color: rgba(0,0,0,0.25);
      text-decoration: none;
      letter-spacing: 0.05em;
    }
    footer a:hover { color: rgba(0,0,0,0.6); }
    .footer-links { display: flex; gap: 24px; }

    /* ── Responsive ── */
    @media (max-width: 767px) {
      header { padding: 20px 24px; }
      .hero { padding: 110px 24px 80px; }
      .section-wrap { padding: 80px 24px; }
      .about-grid { grid-template-columns: 1fr; gap: 48px; }
      .door { padding: 48px 24px; min-height: auto; }
      .contact-grid { grid-template-columns: 1fr; gap: 40px; }
      footer { padding: 28px 24px; flex-direction: column; align-items: flex-start; gap: 8px; }
    }
  </style>
</head>
<body class="lang-en">

  <header>
    <a href="/" class="logo-link">
      <svg width="22" height="20" viewBox="0 0 1579 1464" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path class="lp" d="M845.534 1.61656C722.602 298.182 451.535 572.409 0.514358 572.336V673.003C125.651 673.003 243.586 694.9 364.534 731.053C265.042 771.834 142.698 791.747 0.587839 791.747L0 892.635C311.041 894.987 536.11 1037.68 729.509 1251.51L729.436 1097.2C607.459 969.863 488.422 899.763 340.947 848.621C403.552 831.941 451.314 813.277 507.232 787.559C595.482 835.615 654.854 878.307 728.995 935.988L728.848 801.299C679.91 766.911 664.48 754.64 624.947 730.612C717.753 671.534 766.249 632.075 845.167 563.445L845.24 417.219C727.599 549.116 639.717 613.705 508.776 677.045C441.762 648.241 399.217 632.369 341.021 617.305C545.442 540.592 699.089 415.015 844.947 213.974L844.726 207.14L844.653 0L845.167 1.61656H845.534Z"/>
        <path class="lp" d="M845.534 209.344C1012.77 419.35 1222.63 568.073 1578.64 573.364V672.341C1425.36 673.958 1318.45 698.353 1210.22 734.138C1309.49 773.376 1413.83 793.216 1577.54 792.995L1577.1 892.267C1245.56 898.954 950.831 1086.03 729.876 1463.21V1245.41C852.809 1056.05 1005.06 937.751 1235.49 848.252C1167.16 827.237 1127.48 812.982 1072.22 786.75C938.78 859.642 847.444 928.933 730.905 1054.51L730.832 903.142C806.296 828.78 866.843 779.622 954.358 730.243C901.379 696.149 875.44 680.057 845.828 662.348L845.975 532.95C923.937 594.452 978.827 635.087 1069.43 678.587C1135.19 645.448 1171.34 634.499 1235.71 615.762C1063.77 547.719 971.773 481.22 845.24 370.412L845.754 209.344H845.534Z"/>
      </svg>
      SEDAIIA
    </a>
    <div class="lang-toggle">
      <button class="lang-btn active" data-lang-set="en">EN</button>
      <span class="lang-sep">/</span>
      <button class="lang-btn" data-lang-set="nl">NL</button>
    </div>
  </header>

  <main>

    <!-- 1. Hero -->
    <div class="hero">
      {heroImageUrl && (
        <div class="hero-bg"><img src={heroImageUrl} alt="" /></div>
      )}
      <div class="hero-content">
        <h1 class="hero-headline">
          <span data-lang="en" set:html={toHeadlineHtml(heroHeadlineEn)} />
          <span data-lang="nl" set:html={toHeadlineHtml(heroHeadlineNl)} />
        </h1>
        <p class="hero-sub">
          <span data-lang="en">{heroSubEn}</span>
          <span data-lang="nl">{heroSubNl}</span>
        </p>
      </div>
    </div>

    <!-- 2. Manifest -->
    <div class="section-wrap">
      <span class="section-label">
        <span data-lang="en">WHY THIS WORKS DIFFERENTLY</span>
        <span data-lang="nl">WAAROM DIT ANDERS WERKT</span>
      </span>
      <div data-lang="en">
        <div class="manifest-body" set:html={toParagraphs(manifestBodyEn)} />
      </div>
      <div data-lang="nl">
        <div class="manifest-body" set:html={toParagraphs(manifestBodyNl)} />
      </div>
      {manifestImageUrl ? (
        <img src={manifestImageUrl} alt="" class="manifest-img" />
      ) : (
        <div class="image-slot">
          <span>IMAGE SLOT — BEFORE / AFTER</span>
        </div>
      )}
    </div>

    <!-- 3. Beliefs -->
    <div class="section-wrap">
      <span class="section-label">
        <span data-lang="en">WHAT I BELIEVE</span>
        <span data-lang="nl">WAT IK GELOOF</span>
      </span>
      <ul class="beliefs-list">
        {beliefs.map((b) => (
          <li>
            <span data-lang="en" set:html={withHighlight(b.textEn, b.highlightEn)} />
            <span data-lang="nl" set:html={withHighlight(b.textNl, b.highlightNl)} />
          </li>
        ))}
      </ul>
    </div>

    <!-- 4. About -->
    <div class="section-wrap">
      <span class="section-label">JOHN PATRICK KOOSMAN</span>
      <div class="about-grid">
        <div>
          <div data-lang="en">
            <div class="about-body" set:html={toParagraphs(aboutBodyEn)} />
          </div>
          <div data-lang="nl">
            <div class="about-body" set:html={toParagraphs(aboutBodyNl)} />
          </div>
          <div class="timeline">
            {timeline.map((row) => (
              <div class="timeline-row">
                <span class="t-year">{row.year}</span>
                <span class="t-desc">
                  <span data-lang="en">{row.descEn}</span>
                  <span data-lang="nl">{row.descNl}</span>
                </span>
              </div>
            ))}
          </div>
        </div>
        <div class="skills">
          {skills.map((sg) => (
            <div class="skill-group">
