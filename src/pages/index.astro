          </svg>
        </div>
      </a>
    </div>

    <!-- 6. Contact -->
    <div class="section-wrap">
      <div class="contact-grid">
        <div>
          <h2 class="contact-headline">
            <span data-lang="en">Available for freelance work and part-time roles.</span>
            <span data-lang="nl">Beschikbaar voor freelance opdrachten en part-time rollen.</span>
          </h2>
          <p class="contact-sub">
            <span data-lang="en">Creative, web design, AI and process.</span>
            <span data-lang="nl">Creatief, webdesign, AI en proces.</span>
          </p>
        </div>
        <div class="contact-fields">
          <div class="contact-field">
            <span class="contact-key">EMAIL</span>
            <a href="mailto:hello@sedaiia.com" class="contact-val">hello@sedaiia.com</a>
          </div>
          <div class="contact-field">
            <span class="contact-key">
              <span data-lang="en">LOCATION</span>
              <span data-lang="nl">LOCATIE</span>
            </span>
            <span class="contact-val">
              <span data-lang="en">Almere, Netherlands</span>
              <span data-lang="nl">Almere, Nederland</span>
            </span>
          </div>
        </div>
      </div>
    </div>

  </main>

  <footer>
    <p>© 2026 Sedaiia — KVK 62290924</p>
    <div class="footer-links">
      <a href="https://studio.sedaiia.com">studio</a>
      <a href="https://lab.sedaiia.com">lab</a>
    </div>
  </footer>

  <script>
    const STORAGE_KEY = 'sedaiia-lang';

    function setLang(lang: string) {
      document.body.className = `lang-${lang}`;
      document.documentElement.lang = lang;
      localStorage.setItem(STORAGE_KEY, lang);
      document.querySelectorAll<HTMLElement>('[data-lang-set]').forEach(btn => {
        btn.classList.toggle('active', (btn as HTMLElement & { dataset: { langSet?: string } }).dataset.langSet === lang);
      });
    }

    const stored = localStorage.getItem(STORAGE_KEY);
    const preferNL = navigator.language?.startsWith('nl');
    setLang(stored ?? (preferNL ? 'nl' : 'en'));

    document.querySelectorAll<HTMLElement>('[data-lang-set]').forEach(btn => {
      btn.addEventListener('click', () => {
        const target = (btn as HTMLElement & { dataset: { langSet?: string } }).dataset.langSet;
        if (target) setLang(target);
      });
    });

    document.querySelector('main')?.classList.add('visible');
  </script>

</body>
</html>
